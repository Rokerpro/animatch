# Environment configuration for AniMatch
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Database (SQLite for dev; Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./animatch.db

# Authentication (argon2 hashing & signed JWT cookies)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token

# Google OAuth (Optional: email/password auth works without credentials)
# In Google Cloud Console: create OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173


# LLM Configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend environment (Vite)
VITE_API_URL=/api
