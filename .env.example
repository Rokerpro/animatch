# Environment configuration for AniMatch
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Database (SQLite for dev; Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./animatch.db

# Authentication (argon2 hashing & signed JWT cookies)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Google OAuth (Mocked in tests / skipped when not provided)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend environment (Vite)
VITE_API_URL=/api
