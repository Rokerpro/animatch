# Environment configuration for AniMatch
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional Sentry error reporting (leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Backend server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
# Reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted for per-IP rate limits
# (comma-separated or JSON list). Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# Database (SQLite for dev; Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./animatch.db

# Authentication (argon2 hashing & signed JWT cookies)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token

# Google OAuth (Optional: email/password auth works without credentials)
# In Google Cloud Console: create OAuth 2.0 Client ID (Web Application)
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173


# Transactional email (password reset, email verification).
# EMAIL_BACKEND=log writes messages to the log; use smtp in production.
EMAIL_BACKEND=log
EMAIL_FROM=AniMatch <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_HOURS=48

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NL_MAX_CHARS=300
NL_TIMEOUT_SECONDS=10
NL_DAILY_LIMIT=20

# Shared rate-limit counters across workers (optional; in-memory when empty)
REDIS_URL=
# Requests per minute per client IP (0 disables)
RATE_LIMIT_RECS_PER_MINUTE=60
RATE_LIMIT_CATALOG_PER_MINUTE=240

# Minutes between checks for a re-synced catalog (rebuilds the rec index); 0 = off
INDEX_REFRESH_MINUTES=0

# Adult-tag relevance required to hide a title; isAdult, Hentai, and Ecchi are always hidden.
MATURE_TAG_MIN_RANK=60

# Frontend environment (Vite)
VITE_API_URL=/api
